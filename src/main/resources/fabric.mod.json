{
  "schemaVersion": 1,
  "id": "arcana",
  "version": "${version}",

  "name": "Arcana",
  "description": "A magic mod, handed down.",
  "authors": [

  ],
  "contact": {

  },

  "environment": "*",
  "entrypoints": {
    "main": [
      "arcana.Arcana"
    ],
    "client": [
      "arcana.client.ArcanaClient"
    ],
    "fabric-datagen": [
      "arcana.datagen.DatagenInit"
    ],
    "emi": [
      "arcana.integration.emi.ArcanaEmiPlugin"
    ],
    "cardinal-components-world": [
      "arcana.cca_components.ComponentInit"
    ],
    "cardinal-components-entity": [
      "arcana.cca_components.ComponentInit"
    ],
    "cardinal-components-chunk": [
      "arcana.cca_components.ComponentInit"
    ]
  },
  "mixins": [
    "arcana.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric": "*",
    "minecraft": "1.21.1",
    "java": ">=21",
    "lib39-core": ">=${lib39_version}",
    "lib39-phantom": ">=${lib39_version}",
    "lib39-tunnel": ">=${lib39_version}",
    "lib39-weld": ">=${lib39_version}",
    "trinkets": ">=${trinkets_version}",
    "cardinal-components-base": ">=${cc_version}",
    "cardinal-components-entity": ">=${cc_version}",
    "cardinal-components-world": ">=${cc_version}",
    "biolith": ">=${biolith_version}",
    "geckolib": ">=${geckolib_version}"
  },
  "suggests": {
    "emi": "*",
    "mcqoy": "*"
  },

  "accessWidener": "arcana.accesswidener",

  "custom": {
    "cardinal-components": [
      "arcana:aura_world",
      "arcana:aura_chunk",
      "arcana:infested_chunk",
      "arcana:warded_chunk",
      "arcana:researcher",
      "arcana:caster",
      "arcana:kd_item",
      "arcana:ca_arrow",
      "arcana:runic_shielding_user",
      "arcana:magic_mirror_queue"
    ]
  }
}